{"events":[{"tStartMs":90,"dDurationMs":1340,"segs":[{"utf8":"- [Host] This episode of Binging with Babish"}]},{"tStartMs":1430,"dDurationMs":1750,"segs":[{"utf8":"is presented by The Singleton."}]},{"tStartMs":3180,"dDurationMs":2650,"segs":[{"utf8":"It's great neat, over ice, or mixed into a cocktail."}]},{"tStartMs":5830,"dDurationMs":2230,"segs":[{"utf8":"The Singleton is perfect if you're new to scotch."}]},{"tStartMs":8060,"dDurationMs":1810,"segs":[{"utf8":"Today, I'm mixing it up in an old fashioned"}]},{"tStartMs":9870,"dDurationMs":2230,"segs":[{"utf8":"with maple twist, which would be a welcome addition"}]},{"tStartMs":12100,"dDurationMs":1800,"segs":[{"utf8":"to any heavy Thanksgiving meal."}]},{"tStartMs":13900,"dDurationMs":1860,"segs":[{"utf8":"Now let's get started on these sweet potatoes."}]},{"tStartMs":15760,"dDurationMs":1410,"segs":[{"utf8":"I'm taking them one step further"}]},{"tStartMs":17170,"dDurationMs":1950,"segs":[{"utf8":"by including the Singleton 12 year old"}]},{"tStartMs":19120,"dDurationMs":1570,"segs":[{"utf8":"as a secret ingredients."}]},{"tStartMs":20690,"dDurationMs":1860,"segs":[{"utf8":"- Screw, it, bring on the yams."}]},{"tStartMs":22550,"dDurationMs":1310,"segs":[{"utf8":"(audience laughs)"}]},{"tStartMs":23860,"dDurationMs":1112,"segs":[{"utf8":"- Will, but you've worked so hard."}]},{"tStartMs":24972,"dDurationMs":1432,"segs":[{"utf8":"- Yams! - Okay."}]},{"tStartMs":26404,"dDurationMs":3000,"segs":[{"utf8":"(audience laughing)"}]},{"tStartMs":30531,"dDurationMs":2079,"segs":[{"utf8":"- Will, I just want to say that I'm real sorry"}]},{"tStartMs":32610,"dDurationMs":2490,"segs":[{"utf8":"for whatever I did to you in high school."}]},{"tStartMs":35100,"dDurationMs":1220,"segs":[{"utf8":"- Oh, it wasn't just me."}]},{"tStartMs":36320,"dDurationMs":1006,"segs":[{"utf8":"We had a club."}]},{"tStartMs":37326,"dDurationMs":1874,"segs":[{"utf8":"- You had a club?"}]},{"tStartMs":39200,"dDurationMs":990,"segs":[{"utf8":"- That's right."}]},{"tStartMs":40190,"dDurationMs":2813,"segs":[{"utf8":"The I hate Rachel Green club. - [Host] Hey, what's up guys?"}]},{"tStartMs":43003,"dDurationMs":1547,"segs":[{"utf8":"Welcome back to Binging with Babish"}]},{"tStartMs":44550,"dDurationMs":1110,"segs":[{"utf8":"where this week we're taking a look"}]},{"tStartMs":45660,"dDurationMs":1690,"segs":[{"utf8":"at the yams from Friends,"}]},{"tStartMs":47350,"dDurationMs":1830,"segs":[{"utf8":"which I'm guessing we're not yams at all,"}]},{"tStartMs":49180,"dDurationMs":1540,"segs":[{"utf8":"but sweet potatoes like these ones."}]},{"tStartMs":50720,"dDurationMs":2170,"segs":[{"utf8":"Here in the states, the word yam and sweet potato"}]},{"tStartMs":52890,"dDurationMs":1160,"segs":[{"utf8":"are used interchangeably,"}]},{"tStartMs":54050,"dDurationMs":3040,"segs":[{"utf8":"but they are an entirely different genus of things."}]},{"tStartMs":57090,"dDurationMs":1950,"segs":[{"utf8":"And since real yams are typically imported"}]},{"tStartMs":59040,"dDurationMs":2360,"segs":[{"utf8":"from tropical climates, the domestic sweet potato"}]},{"tStartMs":61400,"dDurationMs":1310,"segs":[{"utf8":"is going to be our weapon of choice."}]},{"tStartMs":62710,"dDurationMs":2730,"segs":[{"utf8":"I've got three large ones here, about four pounds worth,"}]},{"tStartMs":65440,"dDurationMs":2760,"segs":[{"utf8":"that I'm going to peel and cut into one inch chunks."}]},{"tStartMs":68200,"dDurationMs":1380,"segs":[{"utf8":"It doesn't have to be an exact science."}]},{"tStartMs":69580,"dDurationMs":1720,"segs":[{"utf8":"You want them to be roughly the same size."}]},{"tStartMs":71300,"dDurationMs":2000,"segs":[{"utf8":"So they cook at roughly the same rate."}]},{"tStartMs":73300,"dDurationMs":2100,"segs":[{"utf8":"As we cook them the way we would most potatoes,"}]},{"tStartMs":75400,"dDurationMs":2090,"segs":[{"utf8":"in cold water brought to a boil."}]},{"tStartMs":77490,"dDurationMs":1420,"segs":[{"utf8":"Once we've heavily salted these guys"}]},{"tStartMs":78910,"dDurationMs":1050,"segs":[{"utf8":"and brought them up to a simmer"}]},{"tStartMs":79960,"dDurationMs":2090,"segs":[{"utf8":"we're cooking for 12 to 15 minutes"}]},{"tStartMs":82050,"dDurationMs":2480,"segs":[{"utf8":"until completely cooked through and showing no resistance"}]},{"tStartMs":84530,"dDurationMs":1370,"segs":[{"utf8":"when stabbed with a paring knife."}]},{"tStartMs":85900,"dDurationMs":1030,"segs":[{"utf8":"this is going to be the foundation"}]},{"tStartMs":86930,"dDurationMs":2100,"segs":[{"utf8":"for our super basic sweet potato casserole."}]},{"tStartMs":89030,"dDurationMs":1980,"segs":[{"utf8":"Go ahead and drain these and put them in a big old bowl,"}]},{"tStartMs":91010,"dDurationMs":1440,"segs":[{"utf8":"along with some enhancements."}]},{"tStartMs":92450,"dDurationMs":1540,"segs":[{"utf8":"Eight ounces of light brown sugar,"}]},{"tStartMs":93990,"dDurationMs":1820,"segs":[{"utf8":"four ounces of unsalted melted butter,"}]},{"tStartMs":95810,"dDurationMs":1450,"segs":[{"utf8":"a teaspoon of vanilla extract,"}]},{"tStartMs":97260,"dDurationMs":2470,"segs":[{"utf8":"a generous pinch of kosher salt and get to mashing."}]},{"tStartMs":99730,"dDurationMs":2770,"segs":[{"utf8":"Now sweet potatoes are pretty fibrous little tubers,"}]},{"tStartMs":102500,"dDurationMs":833,"segs":[{"utf8":"so you're not going to get these"}]},{"tStartMs":103333,"dDurationMs":1677,"segs":[{"utf8":"super smooth with a potato masher,"}]},{"tStartMs":105010,"dDurationMs":1490,"segs":[{"utf8":"but they'll still be very, very good."}]},{"tStartMs":106500,"dDurationMs":3050,"segs":[{"utf8":"Generously grease a 9 by 13 pan with non-stick spray,"}]},{"tStartMs":109550,"dDurationMs":1120,"segs":[{"utf8":"spread them out nice and evenly,"}]},{"tStartMs":110670,"dDurationMs":1690,"segs":[{"utf8":"but it doesn't matter if you get them super smooth"}]},{"tStartMs":112360,"dDurationMs":1640,"segs":[{"utf8":"because we're going to top them with"}]},{"tStartMs":114000,"dDurationMs":1100,"segs":[{"utf8":"something I wasn't allowed to have"}]},{"tStartMs":115100,"dDurationMs":2000,"segs":[{"utf8":"on my yams as a child, marshmallows."}]},{"tStartMs":117100,"dDurationMs":2410,"segs":[{"utf8":"An entire 10 ounce bag of the mini variety."}]},{"tStartMs":119510,"dDurationMs":1310,"segs":[{"utf8":"Spread those out nice and evenly,"}]},{"tStartMs":120820,"dDurationMs":3510,"segs":[{"utf8":"and then this guy's headed into a 325 degree Fahrenheit oven"}]},{"tStartMs":124330,"dDurationMs":1770,"segs":[{"utf8":"with the rack set in the lowest position"}]},{"tStartMs":126100,"dDurationMs":1880,"segs":[{"utf8":"for anywhere from 25 to 30 minutes"}]},{"tStartMs":127980,"dDurationMs":2110,"segs":[{"utf8":"until the marshmallows are golden brown"}]},{"tStartMs":130090,"dDurationMs":2970,"segs":[{"utf8":"and have coalesced into a pebbly marshmallows singularity."}]},{"tStartMs":133060,"dDurationMs":2240,"segs":[{"utf8":"Let that sit for five to 10 minutes before serving"}]},{"tStartMs":135300,"dDurationMs":1150,"segs":[{"utf8":"and that's all there is to it."}]},{"tStartMs":136450,"dDurationMs":2310,"segs":[{"utf8":"A super simple, unbelievably delicious"}]},{"tStartMs":138760,"dDurationMs":1300,"segs":[{"utf8":"sweet potato casserole."}]},{"tStartMs":140060,"dDurationMs":1700,"segs":[{"utf8":"Now, despite going from raw sweet potato"}]},{"tStartMs":141760,"dDurationMs":1740,"segs":[{"utf8":"to casserole in under an hour,"}]},{"tStartMs":143500,"dDurationMs":1740,"segs":[{"utf8":"it's gotta be the best sweet potato casserole"}]},{"tStartMs":145240,"dDurationMs":1830,"segs":[{"utf8":"I've ever tasted, maybe because I've never tried it"}]},{"tStartMs":147070,"dDurationMs":1090,"segs":[{"utf8":"with marshmallows before."}]},{"tStartMs":148160,"dDurationMs":1620,"segs":[{"utf8":"So what could we possibly do to improve"}]},{"tStartMs":149780,"dDurationMs":1410,"segs":[{"utf8":"on an already perfect food?"}]},{"tStartMs":151190,"dDurationMs":1880,"segs":[{"utf8":"Well, we're going to have to get pretty nit-picky."}]},{"tStartMs":153070,"dDurationMs":860,"segs":[{"utf8":"Now this recipe is going to be"}]},{"tStartMs":153930,"dDurationMs":2040,"segs":[{"utf8":"kind of an amalgamation of improvements."}]},{"tStartMs":155970,"dDurationMs":1840,"segs":[{"utf8":"You can take any one of them and apply it"}]},{"tStartMs":157810,"dDurationMs":2220,"segs":[{"utf8":"to the last recipe and it will have an effect."}]},{"tStartMs":160030,"dDurationMs":2450,"segs":[{"utf8":"First up, instead of boiling our sweet potato cubes,"}]},{"tStartMs":162480,"dDurationMs":1230,"segs":[{"utf8":"we're going to sous vide them."}]},{"tStartMs":163710,"dDurationMs":2050,"segs":[{"utf8":"Food scientist Harold McGee has pointed out"}]},{"tStartMs":165760,"dDurationMs":2970,"segs":[{"utf8":"that sous vide-ing sweet potatoes at 170 degrees Fahrenheit"}]},{"tStartMs":168730,"dDurationMs":1950,"segs":[{"utf8":"activates some kind of enzyme or something"}]},{"tStartMs":170680,"dDurationMs":1600,"segs":[{"utf8":"that makes them naturally sweeter."}]},{"tStartMs":172280,"dDurationMs":2120,"segs":[{"utf8":"So we don't have to use quite as much sugar."}]},{"tStartMs":174400,"dDurationMs":1840,"segs":[{"utf8":"This is going to be far and away the most optional step,"}]},{"tStartMs":176240,"dDurationMs":1470,"segs":[{"utf8":"because it is the biggest pain in the ass,"}]},{"tStartMs":177710,"dDurationMs":2520,"segs":[{"utf8":"especially when you accidentally make your bag too big."}]},{"tStartMs":180230,"dDurationMs":1570,"segs":[{"utf8":"So go ahead and subdivide your potatoes"}]},{"tStartMs":181800,"dDurationMs":2810,"segs":[{"utf8":"into two smaller bags, maybe with a cinnamon stick or two,"}]},{"tStartMs":184610,"dDurationMs":3330,"segs":[{"utf8":"and then drop them into a 170 degree Fahrenheit water bath"}]},{"tStartMs":187940,"dDurationMs":2670,"segs":[{"utf8":"for one and one half hours, weighing down if necessary"}]},{"tStartMs":190610,"dDurationMs":1400,"segs":[{"utf8":"to make sure that they're submerged."}]},{"tStartMs":192010,"dDurationMs":2590,"segs":[{"utf8":"Now, this is going to do that enzyme sweetness thing,"}]},{"tStartMs":194600,"dDurationMs":1710,"segs":[{"utf8":"but it's also going to mostly cook the potatoes"}]},{"tStartMs":196310,"dDurationMs":1300,"segs":[{"utf8":"so that they're ready to mash up"}]},{"tStartMs":197610,"dDurationMs":1480,"segs":[{"utf8":"when they come out of the sous vide."}]},{"tStartMs":199090,"dDurationMs":1050,"segs":[{"utf8":"So while these guys float,"}]},{"tStartMs":200140,"dDurationMs":1230,"segs":[{"utf8":"we're going to make some brown butter."}]},{"tStartMs":201370,"dDurationMs":1920,"segs":[{"utf8":"Dumping five ounces of unsalted butter"}]},{"tStartMs":203290,"dDurationMs":2470,"segs":[{"utf8":"into a medium saucepan, swirling pretty constantly"}]},{"tStartMs":205760,"dDurationMs":2420,"segs":[{"utf8":"over medium heat until the milk solids separate"}]},{"tStartMs":208180,"dDurationMs":1740,"segs":[{"utf8":"and start to turn a nutty brown."}]},{"tStartMs":209920,"dDurationMs":910,"segs":[{"utf8":"Set aside to cool."}]},{"tStartMs":210830,"dDurationMs":1040,"segs":[{"utf8":"And then 90 minutes later,"}]},{"tStartMs":211870,"dDurationMs":1600,"segs":[{"utf8":"we got ourselves some potatoes."}]},{"tStartMs":213470,"dDurationMs":833,"segs":[{"utf8":"Go ahead and fetch these"}]},{"tStartMs":214303,"dDurationMs":2227,"segs":[{"utf8":"out of Davy Jones' miniature locker,"}]},{"tStartMs":216530,"dDurationMs":1260,"segs":[{"utf8":"and place them in a large bowl,"}]},{"tStartMs":217790,"dDurationMs":1500,"segs":[{"utf8":"along with more enhancements."}]},{"tStartMs":219290,"dDurationMs":860,"segs":[{"utf8":"Our brown butter,"}]},{"tStartMs":220150,"dDurationMs":1404,"segs":[{"utf8":"make sure you get all those little brown bits."}]},{"tStartMs":221554,"dDurationMs":2146,"segs":[{"utf8":"Four and a half ounces of light brown sugar,"}]},{"tStartMs":223700,"dDurationMs":1500,"segs":[{"utf8":"four ounces of creme fresh,"}]},{"tStartMs":225200,"dDurationMs":1390,"segs":[{"utf8":"two tablespoons of maple syrup,"}]},{"tStartMs":226590,"dDurationMs":1390,"segs":[{"utf8":"one tablespoon of vanilla paste,"}]},{"tStartMs":227980,"dDurationMs":1510,"segs":[{"utf8":"or a teaspoon of vanilla extract,"}]},{"tStartMs":229490,"dDurationMs":1260,"segs":[{"utf8":"a half teaspoon ground cinnamon,"}]},{"tStartMs":230750,"dDurationMs":1910,"segs":[{"utf8":"quarter teaspoon freshly grated nutmeg,"}]},{"tStartMs":232660,"dDurationMs":1300,"segs":[{"utf8":"generous pinch of kosher salt."}]},{"tStartMs":233960,"dDurationMs":3470,"segs":[{"utf8":"And for both structure and richness, three beaten egg yolks."}]},{"tStartMs":237430,"dDurationMs":1570,"segs":[{"utf8":"Go ahead and mix those all together with a paddle"}]},{"tStartMs":239000,"dDurationMs":1130,"segs":[{"utf8":"until evenly distributed,"}]},{"tStartMs":240130,"dDurationMs":1730,"segs":[{"utf8":"but you'll notice that I'm not mashing"}]},{"tStartMs":241860,"dDurationMs":2040,"segs":[{"utf8":"and that's because I'm going to puree."}]},{"tStartMs":243900,"dDurationMs":2060,"segs":[{"utf8":"The only way to break down all that fibrous junk"}]},{"tStartMs":245960,"dDurationMs":2970,"segs":[{"utf8":"in the sweet potatoes is with the power of a food processor."}]},{"tStartMs":248930,"dDurationMs":2130,"segs":[{"utf8":"Blitzing for about 60 seconds in batches"}]},{"tStartMs":251060,"dDurationMs":1420,"segs":[{"utf8":"until dreamily smooth."}]},{"tStartMs":252480,"dDurationMs":2550,"segs":[{"utf8":"Once again, we're placing this in a 9 by 13 casserole,"}]},{"tStartMs":255030,"dDurationMs":2660,"segs":[{"utf8":"this time generously lubed up with unsalted butter."}]},{"tStartMs":257690,"dDurationMs":1170,"segs":[{"utf8":"Spread it around nice and evenly"}]},{"tStartMs":258860,"dDurationMs":1380,"segs":[{"utf8":"and whatever you do, don't taste it,"}]},{"tStartMs":260240,"dDurationMs":1070,"segs":[{"utf8":"because it has eggs in it."}]},{"tStartMs":261310,"dDurationMs":2350,"segs":[{"utf8":"Andy, Andy, I said, no, tasties,"}]},{"tStartMs":263660,"dDurationMs":970,"segs":[{"utf8":"God, you're difficult."}]},{"tStartMs":264630,"dDurationMs":1450,"segs":[{"utf8":"So now for an added flavor explosion,"}]},{"tStartMs":266080,"dDurationMs":2750,"segs":[{"utf8":"we're going to make ourselves a pecan streusel,"}]},{"tStartMs":268830,"dDurationMs":2180,"segs":[{"utf8":"combining four and a half ounces of all purpose flour,"}]},{"tStartMs":271010,"dDurationMs":1310,"segs":[{"utf8":"six ounces of brown sugar,"}]},{"tStartMs":272320,"dDurationMs":2590,"segs":[{"utf8":"and four and a half ounces of roughly processed pecans."}]},{"tStartMs":274910,"dDurationMs":1760,"segs":[{"utf8":"This kind of undoes any sugar savings"}]},{"tStartMs":276670,"dDurationMs":1790,"segs":[{"utf8":"that we got from our sous vide process,"}]},{"tStartMs":278460,"dDurationMs":1460,"segs":[{"utf8":"so do this at your own risk."}]},{"tStartMs":279920,"dDurationMs":1520,"segs":[{"utf8":"Once all the dry ingredients are combined,"}]},{"tStartMs":281440,"dDurationMs":2110,"segs":[{"utf8":"we're going to add two and a half ounces of melted butter,"}]},{"tStartMs":283550,"dDurationMs":1790,"segs":[{"utf8":"adding more as necessary until the streusel"}]},{"tStartMs":285340,"dDurationMs":2080,"segs":[{"utf8":"has the texture of very wet sand."}]},{"tStartMs":287420,"dDurationMs":1090,"segs":[{"utf8":"Press it together and crumble it"}]},{"tStartMs":288510,"dDurationMs":1320,"segs":[{"utf8":"over the top of the sweet potatoes."}]},{"tStartMs":289830,"dDurationMs":1200,"segs":[{"utf8":"And then this guy's headed into"}]},{"tStartMs":291030,"dDurationMs":1880,"segs":[{"utf8":"that 325 degree Fahrenheit oven"}]},{"tStartMs":292910,"dDurationMs":1840,"segs":[{"utf8":"for the same 25 to 30 minutes."}]},{"tStartMs":294750,"dDurationMs":1050,"segs":[{"utf8":"During which time we can make"}]},{"tStartMs":295800,"dDurationMs":1650,"segs":[{"utf8":"our whiskey marshmallow topping."}]},{"tStartMs":297450,"dDurationMs":1520,"segs":[{"utf8":"We're starting by dissolving half an ounce"}]},{"tStartMs":298970,"dDurationMs":1830,"segs":[{"utf8":"or two packets of unflavored gelatin"}]},{"tStartMs":300800,"dDurationMs":1640,"segs":[{"utf8":"and five ounces of cold water."}]},{"tStartMs":302440,"dDurationMs":2590,"segs":[{"utf8":"Setting that aside to se and then making a sugar syrup."}]},{"tStartMs":305030,"dDurationMs":2120,"segs":[{"utf8":"Into a small saucepan goes six ounces of sugar,"}]},{"tStartMs":307150,"dDurationMs":2450,"segs":[{"utf8":"two ounces of water, one ounce of light corn syrup,"}]},{"tStartMs":309600,"dDurationMs":1600,"segs":[{"utf8":"and two ounces of the Singleton"}]},{"tStartMs":311200,"dDurationMs":2280,"segs":[{"utf8":"12 year old single malt scotch whiskey."}]},{"tStartMs":313480,"dDurationMs":1650,"segs":[{"utf8":"Whisk this together gently to combine"}]},{"tStartMs":315130,"dDurationMs":1460,"segs":[{"utf8":"and place over medium heat,"}]},{"tStartMs":316590,"dDurationMs":1620,"segs":[{"utf8":"covering and bringing to a simmer."}]},{"tStartMs":318210,"dDurationMs":1440,"segs":[{"utf8":"Once it's simmering, take off the lid,"}]},{"tStartMs":319650,"dDurationMs":3150,"segs":[{"utf8":"and then we're going to cook this to 255 degrees Fahrenheit,"}]},{"tStartMs":322800,"dDurationMs":2500,"segs":[{"utf8":"otherwise known as the firm ball stage."}]},{"tStartMs":325300,"dDurationMs":1260,"segs":[{"utf8":"Once that temperature is reached,"}]},{"tStartMs":326560,"dDurationMs":1890,"segs":[{"utf8":"kill the heat, add a little splash of whiskey"}]},{"tStartMs":328450,"dDurationMs":3280,"segs":[{"utf8":"and set aside to cool down to 212 degrees Fahrenheit."}]},{"tStartMs":331730,"dDurationMs":2120,"segs":[{"utf8":"During which time we're going to set our gelatin"}]},{"tStartMs":333850,"dDurationMs":2500,"segs":[{"utf8":"over a double boiler to melt it and combine it"}]},{"tStartMs":336350,"dDurationMs":2370,"segs":[{"utf8":"and our 212 degree Fahrenheit sugar syrup"}]},{"tStartMs":338720,"dDurationMs":1500,"segs":[{"utf8":"in the bowl of a stand mixer."}]},{"tStartMs":340220,"dDurationMs":1535,"segs":[{"utf8":"Then using our wire whisk attachment,"}]},{"tStartMs":341755,"dDurationMs":2385,"segs":[{"utf8":"we're going to whip this guy on medium-high speed,"}]},{"tStartMs":344140,"dDurationMs":1310,"segs":[{"utf8":"starting off slow, of course,"}]},{"tStartMs":345450,"dDurationMs":1550,"segs":[{"utf8":"for up to 10 to 15 minutes"}]},{"tStartMs":347000,"dDurationMs":2040,"segs":[{"utf8":"until it's damn near quadrupled in volume"}]},{"tStartMs":349040,"dDurationMs":2380,"segs":[{"utf8":"and it's reached the stiff peak stage."}]},{"tStartMs":351420,"dDurationMs":1910,"segs":[{"utf8":"And with that, my friends, you have made"}]},{"tStartMs":353330,"dDurationMs":1960,"segs":[{"utf8":"homemade whiskey marshmallow,"}]},{"tStartMs":355290,"dDurationMs":1450,"segs":[{"utf8":"which you could pour into a casserole"}]},{"tStartMs":356740,"dDurationMs":2300,"segs":[{"utf8":"and cut cubes for traditional marshmallows."}]},{"tStartMs":359040,"dDurationMs":1550,"segs":[{"utf8":"Or before it sets, you can pipe it"}]},{"tStartMs":360590,"dDurationMs":1860,"segs":[{"utf8":"onto your slightly cooled casserole."}]},{"tStartMs":362450,"dDurationMs":1120,"segs":[{"utf8":"You want it just cooled enough"}]},{"tStartMs":363570,"dDurationMs":1537,"segs":[{"utf8":"that it doesn't melt the marshmallow."}]},{"tStartMs":365107,"dDurationMs":2683,"segs":[{"utf8":"Then you can let this set for an hour"}]},{"tStartMs":367790,"dDurationMs":2630,"segs":[{"utf8":"and put it in a 350 degree Fahrenheit oven to brown it."}]},{"tStartMs":370420,"dDurationMs":1340,"segs":[{"utf8":"Or if your casserole is still hot"}]},{"tStartMs":371760,"dDurationMs":1940,"segs":[{"utf8":"and you want to eat it right now, you can use a torch."}]},{"tStartMs":373700,"dDurationMs":833,"segs":[{"utf8":"And there you have it."}]},{"tStartMs":374533,"dDurationMs":3027,"segs":[{"utf8":"The ultimate super smooth, super sweet, super crunchy,"}]},{"tStartMs":377560,"dDurationMs":3260,"segs":[{"utf8":"super creamy, super marshmallow-y, sweet potato casserole."}]},{"tStartMs":380820,"dDurationMs":980,"segs":[{"utf8":"I don't have footage of it,"}]},{"tStartMs":381800,"dDurationMs":1450,"segs":[{"utf8":"but we picked that this throughout the day"}]},{"tStartMs":383250,"dDurationMs":2190,"segs":[{"utf8":"and the three of us almost finished the entire thing."}]},{"tStartMs":385440,"dDurationMs":2030,"segs":[{"utf8":"Now, all we need is an accompanying cocktail"}]},{"tStartMs":387470,"dDurationMs":1160,"segs":[{"utf8":"for our holiday meal."}]},{"tStartMs":388630,"dDurationMs":1740,"segs":[{"utf8":"I'm thinking of maple old fashioned,"}]},{"tStartMs":390370,"dDurationMs":1130,"segs":[{"utf8":"for which I'm going to make"}]},{"tStartMs":391500,"dDurationMs":1920,"segs":[{"utf8":"a quick little orange peel garnish,"}]},{"tStartMs":393420,"dDurationMs":1980,"segs":[{"utf8":"and then I'm constructing this cocktail in the glass."}]},{"tStartMs":395400,"dDurationMs":1680,"segs":[{"utf8":"So I've got a big old ice cube here."}]},{"tStartMs":397080,"dDurationMs":2130,"segs":[{"utf8":"Then over top, I'm going to pour one and a half ounces"}]},{"tStartMs":399210,"dDurationMs":2690,"segs":[{"utf8":"of the Singleton 12, a little splash of club soda,"}]},{"tStartMs":401900,"dDurationMs":1800,"segs":[{"utf8":"which I like cause it kind of lightens things up."}]},{"tStartMs":403700,"dDurationMs":1540,"segs":[{"utf8":"A few dashes of your favorite bitters"}]},{"tStartMs":405240,"dDurationMs":2790,"segs":[{"utf8":"and about a teaspoon of maple syrup to taste."}]},{"tStartMs":408030,"dDurationMs":2430,"segs":[{"utf8":"This plays really nice as a sweetener in an old fashioned."}]},{"tStartMs":410460,"dDurationMs":1390,"segs":[{"utf8":"Mix everybody together thoroughly"}]},{"tStartMs":411850,"dDurationMs":1490,"segs":[{"utf8":"by virtue of your bar spoon,"}]},{"tStartMs":413340,"dDurationMs":1220,"segs":[{"utf8":"garnish with your orange twist."}]},{"tStartMs":414560,"dDurationMs":1990,"segs":[{"utf8":"And there you have it, a maple old fashioned."}]},{"tStartMs":416550,"dDurationMs":2030,"segs":[{"utf8":"A perfect pairing for our sweet potato casserole"}]},{"tStartMs":418580,"dDurationMs":2090,"segs":[{"utf8":"or whatever else Thanksgiving throws at you."}]},{"tStartMs":420670,"dDurationMs":2300,"segs":[{"utf8":"Thanks again to the Singleton single malt scotch whiskey"}]},{"tStartMs":422970,"dDurationMs":1710,"segs":[{"utf8":"for partnering with me on this episode"}]},{"tStartMs":424680,"dDurationMs":1390,"segs":[{"utf8":"and the other episodes this year."}]},{"tStartMs":426070,"dDurationMs":2000,"segs":[{"utf8":"If you're intimidated by scotch, don't be."}]},{"tStartMs":428070,"dDurationMs":1980,"segs":[{"utf8":"The Singleton 12 year old is easy to enjoy"}]},{"tStartMs":430050,"dDurationMs":2060,"segs":[{"utf8":"and mixes so well into your favorite cocktails"}]},{"tStartMs":432110,"dDurationMs":1920,"segs":[{"utf8":"because it's light and slightly sweet."}]},{"tStartMs":434030,"dDurationMs":1750,"segs":[{"utf8":"These same flavor notes work wonderfully"}]},{"tStartMs":435780,"dDurationMs":1090,"segs":[{"utf8":"in the sweet potatoes."}]},{"tStartMs":436870,"dDurationMs":2010,"segs":[{"utf8":"When you gather with friends and family this holiday,"}]},{"tStartMs":438880,"dDurationMs":2270,"segs":[{"utf8":"reach for any of the bottles in the Singleton family."}]},{"tStartMs":441150,"dDurationMs":2210,"segs":[{"utf8":"There's something for everyone's taste preference."}]},{"tStartMs":443360,"dDurationMs":1130,"segs":[{"utf8":"To get a bottle for yourself,"}]},{"tStartMs":444490,"dDurationMs":1820,"segs":[{"utf8":"head to the link in the video description."}]},{"tStartMs":446310,"dDurationMs":1020,"segs":[{"utf8":"Thanks again to The Singleton"}]},{"tStartMs":447330,"dDurationMs":1988,"segs":[{"utf8":"for a great partnership this year."}]},{"tStartMs":449318,"dDurationMs":2500,"segs":[{"utf8":"(light music)"}]}]}